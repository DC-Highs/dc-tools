{
    "name": "@dchighs/dc-tools",
    "private": true,
    "version": "0.16.2",
    "type": "commonjs",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{js,ts,mjs,json}\" \".github/workflows/*.yml\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "build": {
        "appId": "dev.marcuth.dchighs.dc-tools",
        "productName": "DC Tools",
        "files": [
            "dist/**/*",
            "electron/dist/**/*"
        ],
        "directories": {
            "buildResources": "assets"
        }
    },
    "dependencies": {
        "@ark-ui/react": "^5.39.3",
        "@base-ui/react": "^1.9.0",
        "@dchighs/dc-assets": "^0.4.3",
        "@dchighs/dc-client-state": "^0.1.0",
        "@dchighs/dc-config": "^0.1.169",
        "@dchighs/dc-core": "^0.4.2",
        "@dchighs/dc-localization": "^0.0.7",
        "@fontsource-variable/outfit": "^5.3.0",
        "@hookform/resolvers": "^6.0.0",
        "@marcuth/dds-to-png": "^0.1.0",
        "@tailwindcss/vite": "^4.3.3",
        "adm-zip": "^0.6.1",
        "bigjpg-open": "^0.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cors": "^2.8.6",
        "electron-store": "^12.0.0",
        "express": "^5.3.0",
        "framer-motion": "^14.6.0",
        "lucide-react": "^1.61.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-icons": "^5.7.0",
        "react-router-dom": "^7.18.4",
        "shadcn": "^4.22.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/adm-zip": "^0.6.0",
        "@types/cors": "^2.8.19",
        "@types/electron": "^1.6.12",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-sort-imports": "^1.8.11",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-electron": "^1.1.2",
        "vite-plugin-electron-renderer": "^1.0.0",
        "vitest": "^5.0.5",
        "wait-on": "^9.5.1"
    }
}
